# Clé privée de votre wallet (SANS le préfixe 0x)
# ⚠️ NE JAMAIS PARTAGER CETTE CLÉ! NE JAMAIS LA COMMITER SUR GIT!
PRIVATE_KEY=votre_cle_privee_ici

# URL RPC pour BSC Testnet (facultatif, une valeur par défaut est fournie)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# URL RPC pour BSC Mainnet (pour future utilisation)
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# Clé API Etherscan V2 pour la vérification du contrat (fonctionne pour toutes les chaînes)
# Obtenez votre clé sur: https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=votre_cle_api_etherscan_v2_ici