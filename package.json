{
  "name": "bitcoinme-token",
  "version": "1.0.0",
  "description": "Bịt Coin Mẹ! Token (BCM) - Déploiement sur BSC Testnet",
  "scripts": {
    "compile": "pnpm check:tokenomics && hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "verify:testnet": "hardhat run scripts/verify.ts --network bscTestnet",
    "typecheck": "tsc --noEmit",
    "lint": "solhint --disc 'contracts/**/*.sol' && prettier --check '**/*.{ts,json,md,yml,yaml}'",
    "format": "prettier --write '**/*.{ts,json,md,yml,yaml}'",
    "coverage": "hardhat coverage && ts-node scripts/check-coverage.ts",
    "generate:tokenomics": "ts-node scripts/generate-tokenomics.ts",
    "check:tokenomics": "ts-node scripts/generate-tokenomics.ts --check",
    "check:forbidden": "hardhat run scripts/check-forbidden.ts --network hardhat",
    "slither": "slither . --hardhat-ignore-compile --filter-paths node_modules --fail-medium",
    "hash:bytecode": "hardhat run scripts/hash-bytecode.ts --network hardhat",
    "verify:claims": "pnpm check:forbidden && ts-node scripts/verify-claims.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-toolbox": "4.0.0",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "25.5.0",
    "chai": "4.5.0",
    "hardhat": "2.28.6",
    "hardhat-gas-reporter": "1.0.10",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.17",
    "solc": "0.8.37",
    "solhint": "6.2.4",
    "prettier": "2.8.8",
    "@nomicfoundation/hardhat-ignition": "0.15.16",
    "@nomicfoundation/ignition-core": "0.15.15"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.16.0"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.8.0"
  }
}
